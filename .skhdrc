# skhd: a right-hand spatial language for Yabai.
#
# Directional key shape:
#       I = north
#   J = west   K = south   L = east
#
# Modifier layers:
#   Option               focus
#   Shift + Option       move / warp
#   Control + Option     resize
#   Meh                  stack (Control + Option + Shift)
#   Hyper                choose insertion point (Meh + Command)
#
# The notifyutil calls update the optional Barik space/window indicators.

# Directional window control ------------------------------------------------

alt - i : "$HOME/.local/bin/shortcut-used" skhd "alt-i" 2>/dev/null || true; yabai -m window --focus north; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
alt - j : "$HOME/.local/bin/shortcut-used" skhd "alt-j" 2>/dev/null || true; yabai -m window --focus west; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
alt - k : "$HOME/.local/bin/shortcut-used" skhd "alt-k" 2>/dev/null || true; yabai -m window --focus south; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
alt - l : "$HOME/.local/bin/shortcut-used" skhd "alt-l" 2>/dev/null || true; yabai -m window --focus east; /usr/bin/notifyutil -z 0 -p com.barik.window_changed

shift + alt - i : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-i" 2>/dev/null || true; yabai -m window --warp north; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - j : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-j" 2>/dev/null || true; yabai -m window --warp west; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - k : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-k" 2>/dev/null || true; yabai -m window --warp south; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - l : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-l" 2>/dev/null || true; yabai -m window --warp east; /usr/bin/notifyutil -z 0 -p com.barik.window_changed

lctrl + alt - i : "$HOME/.local/bin/shortcut-used" skhd "ctrl+alt-i" 2>/dev/null || true; \
    yabai -m window --resize top:0:-75 ; \
    yabai -m window --resize bottom:0:-75

lctrl + alt - j : "$HOME/.local/bin/shortcut-used" skhd "ctrl+alt-j" 2>/dev/null || true; \
    yabai -m window --resize left:-75:0 ; \
    yabai -m window --resize right:-75:0

lctrl + alt - k : "$HOME/.local/bin/shortcut-used" skhd "ctrl+alt-k" 2>/dev/null || true; \
    yabai -m window --resize bottom:0:75 ; \
    yabai -m window --resize top:0:75

lctrl + alt - l : "$HOME/.local/bin/shortcut-used" skhd "ctrl+alt-l" 2>/dev/null || true; \
    yabai -m window --resize right:75:0 ; \
    yabai -m window --resize left:75:0

meh - i : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-i" 2>/dev/null || true; yabai -m window --stack north; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
meh - j : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-j" 2>/dev/null || true; yabai -m window --stack west; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
meh - k : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-k" 2>/dev/null || true; yabai -m window --stack south; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
meh - l : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-l" 2>/dev/null || true; yabai -m window --stack east; /usr/bin/notifyutil -z 0 -p com.barik.window_changed

hyper - i : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-i" 2>/dev/null || true; yabai -m window --insert north
hyper - j : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-j" 2>/dev/null || true; yabai -m window --insert west
hyper - k : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-k" 2>/dev/null || true; yabai -m window --insert south
hyper - l : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-l" 2>/dev/null || true; yabai -m window --insert east

# Stack navigation ----------------------------------------------------------

alt - o : "$HOME/.local/bin/shortcut-used" skhd "alt-o" 2>/dev/null || true; "$HOME/.config/yabai/cycle-stack.zsh" prev
alt - u : "$HOME/.local/bin/shortcut-used" skhd "alt-u" 2>/dev/null || true; "$HOME/.config/yabai/cycle-stack.zsh" next

# W/E are an alternate pair for the same stack navigation.
alt - w : "$HOME/.local/bin/shortcut-used" skhd "alt-w" 2>/dev/null || true; "$HOME/.config/yabai/cycle-stack.zsh" prev
alt - e : "$HOME/.local/bin/shortcut-used" skhd "alt-e" 2>/dev/null || true; "$HOME/.config/yabai/cycle-stack.zsh" next

alt - h : "$HOME/.local/bin/shortcut-used" skhd "alt-h" 2>/dev/null || true; yabai -m window --focus first; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - h : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-h" 2>/dev/null || true; yabai -m window --insert stack

# Direct space focus --------------------------------------------------------
# Physical keycodes make the number row independent of the active layout:
# 0x12..0x1D below map to 1,2,3,4,5,6,7,8,9,0.

alt - 0x12 : "$HOME/.local/bin/shortcut-used" skhd "alt-1" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.1; yabai -m space --focus 1
alt - 0x13 : "$HOME/.local/bin/shortcut-used" skhd "alt-2" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.2; yabai -m space --focus 2
alt - 0x14 : "$HOME/.local/bin/shortcut-used" skhd "alt-3" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.3; yabai -m space --focus 3
alt - 0x15 : "$HOME/.local/bin/shortcut-used" skhd "alt-4" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.4; yabai -m space --focus 4
alt - 0x17 : "$HOME/.local/bin/shortcut-used" skhd "alt-5" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.5; yabai -m space --focus 5
alt - 0x16 : "$HOME/.local/bin/shortcut-used" skhd "alt-6" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.6; yabai -m space --focus 6
alt - 0x1A : "$HOME/.local/bin/shortcut-used" skhd "alt-7" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.7; yabai -m space --focus 7
alt - 0x1C : "$HOME/.local/bin/shortcut-used" skhd "alt-8" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.8; yabai -m space --focus 8
alt - 0x19 : "$HOME/.local/bin/shortcut-used" skhd "alt-9" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.9; yabai -m space --focus 9
alt - 0x1D : "$HOME/.local/bin/shortcut-used" skhd "alt-0" 2>/dev/null || true; s=$(yabai -m query --spaces --space last | jq -re .index) && /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus last

# Fn offers the same direct layer when that modifier is easier to reach.
fn - 0x12 : "$HOME/.local/bin/shortcut-used" skhd "fn-1" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.1; yabai -m space --focus 1
fn - 0x13 : "$HOME/.local/bin/shortcut-used" skhd "fn-2" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.2; yabai -m space --focus 2
fn - 0x14 : "$HOME/.local/bin/shortcut-used" skhd "fn-3" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.3; yabai -m space --focus 3
fn - 0x15 : "$HOME/.local/bin/shortcut-used" skhd "fn-4" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.4; yabai -m space --focus 4
fn - 0x17 : "$HOME/.local/bin/shortcut-used" skhd "fn-5" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.5; yabai -m space --focus 5
fn - 0x16 : "$HOME/.local/bin/shortcut-used" skhd "fn-6" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.6; yabai -m space --focus 6
fn - 0x1A : "$HOME/.local/bin/shortcut-used" skhd "fn-7" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.7; yabai -m space --focus 7
fn - 0x1C : "$HOME/.local/bin/shortcut-used" skhd "fn-8" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.8; yabai -m space --focus 8
fn - 0x19 : "$HOME/.local/bin/shortcut-used" skhd "fn-9" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.9; yabai -m space --focus 9
fn - 0x1D : "$HOME/.local/bin/shortcut-used" skhd "fn-0" 2>/dev/null || true; s=$(yabai -m query --spaces --space last | jq -re .index) && /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus last

# Fn + Option extends the number row to spaces 10..19.
fn + alt - 0x12 : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-1" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.10; yabai -m space --focus 10
fn + alt - 0x13 : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-2" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.11; yabai -m space --focus 11
fn + alt - 0x14 : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-3" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.12; yabai -m space --focus 12
fn + alt - 0x15 : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-4" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.13; yabai -m space --focus 13
fn + alt - 0x17 : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-5" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.14; yabai -m space --focus 14
fn + alt - 0x16 : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-6" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.15; yabai -m space --focus 15
fn + alt - 0x1A : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-7" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.16; yabai -m space --focus 16
fn + alt - 0x1C : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-8" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.17; yabai -m space --focus 17
fn + alt - 0x19 : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-9" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.18; yabai -m space --focus 18
fn + alt - 0x1D : "$HOME/.local/bin/shortcut-used" skhd "fn+alt-0" 2>/dev/null || true; /usr/bin/notifyutil -z 0 -p com.barik.space_requested.19; yabai -m space --focus 19

# Relative space focus: N/M are primary; Z/X and comma/period are aliases.
# -z 0 avoids notifyutil's default 100 ms sleep before the focus command.
# Focus the queried index so overlapping repeats cannot announce a different target.
alt - 0x2D : "$HOME/.local/bin/shortcut-used" skhd "alt-n" 2>/dev/null || true; s=$(yabai -m query --spaces --space prev | jq -re .index) && { /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus "$s"; }
alt - 0x2E : "$HOME/.local/bin/shortcut-used" skhd "alt-m" 2>/dev/null || true; s=$(yabai -m query --spaces --space next | jq -re .index) && { /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus "$s"; }
alt - 0x06 : "$HOME/.local/bin/shortcut-used" skhd "alt-z" 2>/dev/null || true; s=$(yabai -m query --spaces --space prev | jq -re .index) && { /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus "$s"; }
alt - 0x07 : "$HOME/.local/bin/shortcut-used" skhd "alt-x" 2>/dev/null || true; s=$(yabai -m query --spaces --space next | jq -re .index) && { /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus "$s"; }
alt - 0x2B : "$HOME/.local/bin/shortcut-used" skhd "alt-," 2>/dev/null || true; s=$(yabai -m query --spaces --space prev | jq -re .index) && { /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus "$s"; }
alt - 0x2F : "$HOME/.local/bin/shortcut-used" skhd "alt-." 2>/dev/null || true; s=$(yabai -m query --spaces --space next | jq -re .index) && { /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus "$s"; }

# Space creation and movement ----------------------------------------------

# Shift + Option + equals/minus creates or destroys a space.
shift + alt - 0x18 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-=" 2>/dev/null || true; yabai -m space --create && (s=$(yabai -m query --spaces --space last | jq -re .index); [ -z "$s" ] || /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus last)
shift + alt - 0x1B : "$HOME/.local/bin/shortcut-used" skhd "shift+alt--" 2>/dev/null || true; yabai -m space mouse --destroy && (s=$(yabai -m query --spaces --space last | jq -re .index); [ -z "$s" ] || /usr/bin/notifyutil -z 0 -p com.barik.space_requested.$s; yabai -m space --focus last)

# Meh + number moves the current space to that position.
meh - 0x12 : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-1" 2>/dev/null || true; yabai -m space --move 1; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x13 : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-2" 2>/dev/null || true; yabai -m space --move 2; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x14 : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-3" 2>/dev/null || true; yabai -m space --move 3; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x15 : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-4" 2>/dev/null || true; yabai -m space --move 4; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x17 : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-5" 2>/dev/null || true; yabai -m space --move 5; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x16 : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-6" 2>/dev/null || true; yabai -m space --move 6; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x1A : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-7" 2>/dev/null || true; yabai -m space --move 7; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x1C : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-8" 2>/dev/null || true; yabai -m space --move 8; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x19 : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-9" 2>/dev/null || true; yabai -m space --move 9; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh - 0x1D : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-0" 2>/dev/null || true; yabai -m space --move 10; /usr/bin/notifyutil -z 0 -p com.barik.space_changed

# Easy-reach aliases for moving the current space to positions 6..10.
meh + fn - 0x12 : "$HOME/.local/bin/shortcut-used" skhd "fn+ctrl+shift+alt-1" 2>/dev/null || true; yabai -m space --move 6; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh + fn - 0x13 : "$HOME/.local/bin/shortcut-used" skhd "fn+ctrl+shift+alt-2" 2>/dev/null || true; yabai -m space --move 7; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh + fn - 0x14 : "$HOME/.local/bin/shortcut-used" skhd "fn+ctrl+shift+alt-3" 2>/dev/null || true; yabai -m space --move 8; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh + fn - 0x15 : "$HOME/.local/bin/shortcut-used" skhd "fn+ctrl+shift+alt-4" 2>/dev/null || true; yabai -m space --move 9; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
meh + fn - 0x17 : "$HOME/.local/bin/shortcut-used" skhd "fn+ctrl+shift+alt-5" 2>/dev/null || true; yabai -m space --move 10; /usr/bin/notifyutil -z 0 -p com.barik.space_changed

# Shift + Option + comma/period moves the current space left/right.
shift + alt - 0x2B : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-," 2>/dev/null || true; yabai -m space --move prev; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x2F : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-." 2>/dev/null || true; yabai -m space --move next; /usr/bin/notifyutil -z 0 -p com.barik.space_changed

# Move focused window between spaces ---------------------------------------

shift + alt - 0x12 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-1" 2>/dev/null || true; yabai -m window --space 1; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x13 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-2" 2>/dev/null || true; yabai -m window --space 2; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x14 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-3" 2>/dev/null || true; yabai -m window --space 3; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x15 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-4" 2>/dev/null || true; yabai -m window --space 4; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x17 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-5" 2>/dev/null || true; yabai -m window --space 5; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x16 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-6" 2>/dev/null || true; yabai -m window --space 6; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x1A : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-7" 2>/dev/null || true; yabai -m window --space 7; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x1C : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-8" 2>/dev/null || true; yabai -m window --space 8; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x19 : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-9" 2>/dev/null || true; yabai -m window --space 9; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x1D : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-0" 2>/dev/null || true; yabai -m window --space last; /usr/bin/notifyutil -z 0 -p com.barik.space_changed

# Easy-reach aliases for sending a window to spaces 6..9 or the last space.
fn + shift + alt - 0x12 : "$HOME/.local/bin/shortcut-used" skhd "fn+shift+alt-1" 2>/dev/null || true; yabai -m window --space 6; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
fn + shift + alt - 0x13 : "$HOME/.local/bin/shortcut-used" skhd "fn+shift+alt-2" 2>/dev/null || true; yabai -m window --space 7; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
fn + shift + alt - 0x14 : "$HOME/.local/bin/shortcut-used" skhd "fn+shift+alt-3" 2>/dev/null || true; yabai -m window --space 8; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
fn + shift + alt - 0x15 : "$HOME/.local/bin/shortcut-used" skhd "fn+shift+alt-4" 2>/dev/null || true; yabai -m window --space 9; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
fn + shift + alt - 0x17 : "$HOME/.local/bin/shortcut-used" skhd "fn+shift+alt-5" 2>/dev/null || true; yabai -m window --space last; /usr/bin/notifyutil -z 0 -p com.barik.space_changed

# Shift + Option + N/M sends a window to the previous/next space.
shift + alt - 0x2D : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-n" 2>/dev/null || true; yabai -m window --space prev; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
shift + alt - 0x2E : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-m" 2>/dev/null || true; yabai -m window --space next; /usr/bin/notifyutil -z 0 -p com.barik.space_changed

# Layout and window state ---------------------------------------------------

hyper - b : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-b" 2>/dev/null || true; yabai -m space --layout bsp; /usr/bin/notifyutil -z 0 -p com.barik.space_changed
hyper - u : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-u" 2>/dev/null || true; yabai -m space --layout float; /usr/bin/notifyutil -z 0 -p com.barik.space_changed

shift + alt - p : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-p" 2>/dev/null || true; yabai -m window --toggle split; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - r : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-r" 2>/dev/null || true; yabai -m space --rotate 90; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - e : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-e" 2>/dev/null || true; yabai -m space --rotate 270; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - x : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-x" 2>/dev/null || true; yabai -m space --mirror x-axis; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - t : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-t" 2>/dev/null || true; yabai -m space --mirror y-axis; /usr/bin/notifyutil -z 0 -p com.barik.window_changed

shift + alt - space : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-space" 2>/dev/null || true; yabai -m window --toggle float; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
meh - s : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-s" 2>/dev/null || true; yabai -m window --toggle sticky; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
lctrl + alt - 0x1D : "$HOME/.local/bin/shortcut-used" skhd "ctrl+alt-0" 2>/dev/null || true; yabai -m space --balance

alt - f : "$HOME/.local/bin/shortcut-used" skhd "alt-f" 2>/dev/null || true; yabai -m window --toggle zoom-fullscreen; /usr/bin/notifyutil -z 0 -p com.barik.window_changed
shift + alt - f : "$HOME/.local/bin/shortcut-used" skhd "shift+alt-f" 2>/dev/null || true; yabai -m window --toggle native-fullscreen; /usr/bin/notifyutil -z 0 -p com.barik.window_changed

hyper - o : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-o" 2>/dev/null || true; yabai -m config window_opacity on
meh - p : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-p" 2>/dev/null || true; yabai -m window --opacity 1.0
meh - o : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-o" 2>/dev/null || true; yabai -m window --opacity 0.0

meh - y : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-y" 2>/dev/null || true; yabai --restart-service

# Scratchpad and Barik media helpers ---------------------------------------

ctrl + cmd - a : "$HOME/.local/bin/shortcut-used" skhd "ctrl+cmd-a" 2>/dev/null || true; "$HOME/.config/yabai/toggle-scratchpad.zsh" chatgpt ChatGPT "ChatGPT scratchpad"
alt + cmd - e : "$HOME/.local/bin/shortcut-used" skhd "alt+cmd-e" 2>/dev/null || true; "$HOME/.config/yabai/toggle-scratchpad.zsh" telegram Telegram "Telegram scratchpad"
cmd + alt - s : "$HOME/.local/bin/shortcut-used" skhd "alt+cmd-s" 2>/dev/null || true; "$HOME/.config/yabai/toggle-scratchpad.zsh" spotify Spotify "Spotify scratchpad"
meh - d : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt-d" 2>/dev/null || true; touch /tmp/.barik-spotify-like
hyper - d : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift+alt+cmd-d" 2>/dev/null || true; touch /tmp/.barik-spotify-unlike

# Input-source helpers ------------------------------------------------------
# macism prevents these phonetic-layout helpers from firing on other layouts.

ctrl - i : "$HOME/.local/bin/shortcut-used" skhd "ctrl-i" 2>/dev/null || true; /opt/homebrew/bin/macism | grep -qE "Ukrainian-QWERTY|Russian-Phonetic" && skhd -t "ї"
shift + ctrl - i : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift-i" 2>/dev/null || true; /opt/homebrew/bin/macism | grep -qE "Ukrainian-QWERTY|Russian-Phonetic" && skhd -t "Ї"
ctrl - w : "$HOME/.local/bin/shortcut-used" skhd "ctrl-w" 2>/dev/null || true; /opt/homebrew/bin/macism | grep -qE "Ukrainian-QWERTY|Russian-Phonetic" && skhd -t "щ"
shift + ctrl - w : "$HOME/.local/bin/shortcut-used" skhd "ctrl+shift-w" 2>/dev/null || true; /opt/homebrew/bin/macism | grep -qE "Ukrainian-QWERTY|Russian-Phonetic" && skhd -t "Щ"

# Browser tab layer ---------------------------------------------------------

ctrl - z [
    "orion" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-z" 2>/dev/null || true; skhd -k "ctrl + shift - tab"
    "chrome" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-z" 2>/dev/null || true; skhd -k "ctrl + shift - tab"
    "zen" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-z" 2>/dev/null || true; skhd -k "ctrl + shift - tab"
]

ctrl - x [
    "orion" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-x" 2>/dev/null || true; skhd -k "ctrl - tab"
    "chrome" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-x" 2>/dev/null || true; skhd -k "ctrl - tab"
    "zen" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-x" 2>/dev/null || true; skhd -k "ctrl - tab"
]

ctrl - c [
    "orion" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-c" 2>/dev/null || true; skhd -k "cmd - w"
    "chrome" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-c" 2>/dev/null || true; skhd -k "cmd - w"
    "zen" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-c" 2>/dev/null || true; skhd -k "cmd - w"
]

ctrl - v [
    "orion" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-v" 2>/dev/null || true; skhd -k "cmd - t"
    "chrome" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-v" 2>/dev/null || true; skhd -k "cmd - t"
    "zen" : "$HOME/.local/bin/shortcut-used" skhd "ctrl-v" 2>/dev/null || true; skhd -k "cmd - t"
]

# Homerow ------------------------------------------------------------------

alt - d : "$HOME/.local/bin/shortcut-used" skhd "alt-d" 2>/dev/null || true; skhd -k "alt - space"
