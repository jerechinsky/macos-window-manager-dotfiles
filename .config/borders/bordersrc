#!/usr/bin/env zsh

# JankyBorders: bright teal focus ring with a quiet translucent inactive ring.
# The blacklist keeps menu-bar utilities and intentionally floating helpers clean.

borders "active_color=glow(0xFF00B8B8)" inactive_color=0x4DFFFFFF width=3 hidpi=on blacklist="Spotify,Raycast,SoundSource,BetterDisplay,Godspeed"
